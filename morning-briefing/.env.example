# Telegram Bot Configuration
# Create a bot via Telegram @BotFather to get your token
TELEGRAM_BOT_TOKEN=
# Get your Chat ID via @userinfobot or channel username (e.g. @mychannel or 123456789)
TELEGRAM_CHAT_ID=

# Stock Tickers Configuration (comma separated)
INDICES=^GSPC,^IXIC,^DJI
EQUITIES=NVDA,AAPL,MSFT,TSLA,GOOGL,AMZN

# Preferred Timezone for Date Headers
TIMEZONE=Asia/Seoul
