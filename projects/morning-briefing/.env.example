# Telegram Bot Configuration
# Create a bot via Telegram @BotFather to get your token
TELEGRAM_BOT_TOKEN=
# Get your Chat ID via @userinfobot or channel username (e.g. @mychannel or 123456789)
TELEGRAM_CHAT_ID=

# News selection & Korean summaries (optional; falls back to rule-based
# ranking + machine translation when neither is set).
# Free: GitHub Models - personal access token with models:read permission.
# (In GitHub Actions the built-in GITHUB_TOKEN is used automatically.)
GITHUB_MODELS_TOKEN=
# GITHUB_MODELS=openai/gpt-4.1-mini,openai/gpt-4o-mini
# Paid: Claude API key (takes priority over GitHub Models when set)
ANTHROPIC_API_KEY=
# CLAUDE_MODEL=claude-opus-5-5
# CLAUDE_EFFORT=medium

# Print the briefing instead of sending it to Telegram
# DRY_RUN=true

# Stock Tickers Configuration (comma separated)
INDICES=^GSPC,^IXIC,^DJI
EQUITIES=NVDA,AAPL,MSFT,TSLA,GOOGL,AMZN,NTAP

# Preferred Timezone for Date Headers
TIMEZONE=Asia/Seoul
